#!/usr/bin/env bash
set -e

cd "$(dirname "$0")/.."

echo "⚙️ Setting up development environment with uv..."

# Ensure uv is installed
if ! command -v uv &> /dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

uv sync --extra dev

# Install HACS into config/custom_components/hacs
mkdir -p config/custom_components
if [ ! -d "config/custom_components/hacs" ]; then
    echo "📦 Downloading HACS..."
    mkdir -p config/custom_components/hacs
    wget -qO- https://github.com/hacs/integration/releases/latest/download/hacs.zip > /tmp/hacs.zip
    unzip -q -o /tmp/hacs.zip -d config/custom_components/hacs
    rm -f /tmp/hacs.zip
    echo "✅ HACS installed."
fi

# Symlink custom_components/xiaomi_feeder into config/custom_components/
ln -snf "$(pwd)/custom_components/xiaomi_feeder" "$(pwd)/config/custom_components/xiaomi_feeder"

echo "🎉 Setup complete! Run './scripts/develop' to start Home Assistant."
